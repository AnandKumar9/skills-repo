<starlight-theme-select class="theme-control">
  <button type="button" data-dci-starlight-theme-toggle data-mode="auto" aria-label="Theme: System">
    <span class="icon icon-system" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M12 3v2.25" />
        <path d="M12 18.75V21" />
        <path d="M3 12h2.25" />
        <path d="M18.75 12H21" />
        <path d="m5.64 5.64 1.59 1.59" />
        <path d="m16.77 16.77 1.59 1.59" />
        <path d="m18.36 5.64-1.59 1.59" />
        <path d="m7.23 16.77-1.59 1.59" />
        <circle cx="12" cy="12" r="4" />
      </svg>
    </span>
    <span class="icon icon-light" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2.5v2" />
        <path d="M12 19.5v2" />
        <path d="M4.25 4.25 5.7 5.7" />
        <path d="m18.3 18.3 1.45 1.45" />
        <path d="M2.5 12h2" />
        <path d="M19.5 12h2" />
        <path d="m4.25 19.75 1.45-1.45" />
        <path d="m18.3 5.7 1.45-1.45" />
      </svg>
    </span>
    <span class="icon icon-dark" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M20.5 14.4A7.8 7.8 0 0 1 9.6 3.5 8.7 8.7 0 1 0 20.5 14.4Z" />
      </svg>
    </span>
    <span class="mode-label">System</span>
  </button>
</starlight-theme-select>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = "auto" | "dark" | "light";

  const storageKey = "theme-preference";
  const labels = {
    auto: "System",
    light: "Light",
    dark: "Dark",
  };
  const media = matchMedia("(prefers-color-scheme: light)");

  const parseTheme = (theme: unknown): Theme =>
    theme === "auto" || theme === "dark" || theme === "light" ? theme : "auto";

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== "undefined" && localStorage.getItem(storageKey));

  const storeTheme = (theme: Theme) => {
    if (typeof localStorage !== "undefined") {
      if (theme === "light" || theme === "dark") {
        localStorage.setItem(storageKey, theme);
      } else {
        localStorage.removeItem(storageKey);
      }
    }
  };

  const getPreferredColorScheme = (): Exclude<Theme, "auto"> =>
    media.matches ? "light" : "dark";

  const getOppositeMode = (mode: Exclude<Theme, "auto">): Exclude<Theme, "auto"> =>
    mode === "dark" ? "light" : "dark";

  const updateButtons = (theme: Theme) => {
    const visibleLabel = theme === "auto" ? `System (${labels[getPreferredColorScheme()]})` : labels[theme];

    document.querySelectorAll<HTMLButtonElement>("[data-dci-starlight-theme-toggle]").forEach((button) => {
      const label = button.querySelector<HTMLElement>(".mode-label");
      if (label) label.textContent = visibleLabel;
      button.dataset.mode = theme;
      button.setAttribute("aria-label", `Theme: ${visibleLabel}`);
      button.setAttribute("title", `Theme: ${visibleLabel}`);
    });
  };

  const onThemeChange = (theme: Theme) => {
    StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === "auto" ? getPreferredColorScheme() : theme;
    storeTheme(theme);
    updateButtons(theme);
  };

  media.addEventListener("change", () => {
    const theme = loadTheme();
    if (theme === "auto") onThemeChange("auto");
    updateButtons(theme);
  });

  class DciStarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      onThemeChange(loadTheme());

      this.querySelector<HTMLButtonElement>("[data-dci-starlight-theme-toggle]")?.addEventListener("click", () => {
        const currentTheme = loadTheme();
        const nextTheme = currentTheme === "auto" ? getOppositeMode(getPreferredColorScheme()) : "auto";
        onThemeChange(nextTheme);
      });
    }
  }

  if (!customElements.get("starlight-theme-select")) {
    customElements.define("starlight-theme-select", DciStarlightThemeSelect);
  }
</script>

<style>
  .theme-control {
    display: inline-flex;
  }

  button {
    align-items: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    justify-content: center;
    line-height: 1;
    min-height: 2.5rem;
    min-width: 2.5rem;
    overflow: hidden;
    padding: 0;
    width: 2.5rem;
  }

  button:hover {
    border-color: var(--sl-color-accent-high);
    color: var(--sl-color-accent-high);
  }

  button:focus-visible {
    border-color: var(--sl-color-accent-high);
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .icon {
    display: none;
    height: 1.15rem;
    flex: 0 0 auto;
    width: 1.15rem;
  }

  button[data-mode="auto"] .icon-system,
  button[data-mode="light"] .icon-light,
  button[data-mode="dark"] .icon-dark {
    display: block;
  }

  svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .icon > svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .mode-label {
    clip: rect(0 0 0 0);
    border: 0;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>
