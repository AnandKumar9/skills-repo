---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  isHome?: boolean;
  pageTitle?: string;
  pageDescription?: string;
}

const { isHome = false, pageTitle, pageDescription } = Astro.props;
const siteTitle = "DCI AI Hub";
const homeHref = import.meta.env.BASE_URL;
---

<div class="page-heading">
  <div class="heading-row">
    {
      isHome ? (
        <h1 class="title-lockup">
          <img class="site-icon" src={`${homeHref}site-icon.svg`} alt="" aria-hidden="true" />
          <span>{siteTitle}</span>
        </h1>
      ) : (
        <a class="site-title title-lockup" href={homeHref} aria-label="Go to home page">
          <img class="site-icon" src={`${homeHref}site-icon.svg`} alt="" aria-hidden="true" />
          <span>{siteTitle}</span>
        </a>
      )
    }
    <ThemeToggle />
  </div>

  {
    isHome ? (
      <p class="heading-description">
        A one-stop shop for everything AI in DCI. Check the latest happenings, browse through collection of various AI skills, agents, hooks, rules, and other tools developed and used within DCI. Access guides and tutorials on various AI topics. And more.
      </p>
    ) : (
      pageTitle && (
        <div class="page-copy">
          <h1>{pageTitle}</h1>
          {pageDescription && <p class="heading-description">{pageDescription}</p>}
        </div>
      )
    )
  }
</div>

<style>
  .page-heading {
    background: var(--heading-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 36px;
    padding: 24px;
  }

  .heading-row {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .page-heading :global(.theme-control) {
    flex: 0 0 auto;
    margin-bottom: 0;
  }

  h1,
  .site-title {
    flex: 1 1 auto;
    margin: 0;
    min-width: 0;
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 650;
    letter-spacing: 0;
  }

  .title-lockup {
    display: block;
    padding-left: 1.35em;
    position: relative;
  }

  .site-icon {
    height: 1em;
    left: 0;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.15em;
  }

  .page-copy {
    margin-top: 32px;
  }

  .page-copy h1 {
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .heading-description {
    margin: 0.75rem 0 0;
    max-width: 720px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .site-title {
    color: var(--text);
    text-decoration: none;
  }

  .site-title:hover {
    color: var(--accent-hover);
  }

  .site-title:focus-visible {
    border-radius: 6px;
    outline: 3px solid var(--focus-ring);
    outline-offset: 4px;
  }
</style>
