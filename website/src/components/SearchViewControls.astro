---
interface Props {
  resultLabelPlural?: string;
  resultLabelSingular?: string;
  searchPlaceholder?: string;
  showViewToggle?: boolean;
}

const {
  resultLabelPlural = "items",
  resultLabelSingular = "item",
  searchPlaceholder = "Search",
  showViewToggle = true,
} = Astro.props;
---

<div
  class="search-view-controls"
  data-search-view-controls
  data-result-label-singular={resultLabelSingular}
  data-result-label-plural={resultLabelPlural}
  aria-label="Search and view controls"
>
  <label class="search-field">
    <span class="sr-only">Search</span>
    <input type="search" placeholder={searchPlaceholder} data-search-input />
  </label>

  {
    showViewToggle && (
      <div class="view-toggle" aria-label="View mode">
        <button
          class="view-toggle-button is-active"
          type="button"
          data-view-mode-button="grid"
          aria-pressed="true"
          aria-label="Grid view"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"
            />
          </svg>
        </button>
        <button
          class="view-toggle-button"
          type="button"
          data-view-mode-button="list"
          aria-pressed="false"
          aria-label="List view"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"
            />
          </svg>
        </button>
      </div>
    )
  }
</div>

<script>
  const viewModeStorageKey = "skills-repo:view-mode";

  document.querySelectorAll<HTMLElement>("[data-search-view-controls]").forEach((controls) => {
    const page = controls.closest("main");
    const viewContainer = page?.querySelector<HTMLElement>("[data-view-container]");
    const searchInput = controls.querySelector<HTMLInputElement>("[data-search-input]");
    const searchItems = page?.querySelectorAll<HTMLElement>("[data-search-item]");
    const searchStatus = page?.querySelector<HTMLElement>("[data-search-status]");
    const emptyState = page?.querySelector<HTMLElement>("[data-search-empty]");
    const buttons = controls.querySelectorAll<HTMLButtonElement>("[data-view-mode-button]");

    function isViewMode(mode: string): mode is "grid" | "list" {
      return mode === "grid" || mode === "list";
    }

    function getStoredViewMode() {
      try {
        const storedMode = window.localStorage.getItem(viewModeStorageKey);
        return storedMode && isViewMode(storedMode) ? storedMode : null;
      } catch {
        return null;
      }
    }

    function storeViewMode(mode: string) {
      try {
        window.localStorage.setItem(viewModeStorageKey, mode);
      } catch {
        // Ignore storage failures so the toggle still works in private or restricted contexts.
      }
    }

    function getSearchText(item: HTMLElement) {
      return `${item.dataset.searchName ?? ""} ${item.dataset.searchDescription ?? ""} ${
        item.dataset.searchTags ?? ""
      }`.toLowerCase();
    }

    function formatResultCount(count: number) {
      const singular = controls.dataset.resultLabelSingular ?? "item";
      const plural = controls.dataset.resultLabelPlural ?? "items";
      return `${count} ${count === 1 ? singular : plural}`;
    }

    function updateSearchResults() {
      if (!searchInput || !searchItems) return;

      const query = searchInput.value.trim().toLowerCase();
      const currentView = viewContainer?.dataset.viewMode ?? "grid";
      let visibleCount = 0;

      searchItems.forEach((item) => {
        const isVisible = query.length === 0 || getSearchText(item).includes(query);
        item.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (searchStatus) {
        searchStatus.textContent =
          query.length === 0
            ? `${formatResultCount(visibleCount)} shown`
            : `${formatResultCount(visibleCount)} found for "${searchInput.value.trim()}"`;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    function setViewMode(mode: string, shouldStore = true) {
      if (!viewContainer || buttons.length === 0) return;

      viewContainer.dataset.viewMode = mode;

      buttons.forEach((button) => {
        const isActive = button.dataset.viewModeButton === mode;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });

      if (shouldStore) {
        storeViewMode(mode);
      }

      updateSearchResults();
    }

    if (viewContainer && buttons.length > 0) {
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          setViewMode(button.dataset.viewModeButton ?? "grid");
        });
      });

      setViewMode(getStoredViewMode() ?? viewContainer.dataset.viewMode ?? "grid", false);
    }

    searchInput?.addEventListener("input", updateSearchResults);
    updateSearchResults();
  });
</script>

<style>
  .search-view-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: -8px 0 32px;
  }

  .search-field {
    flex: 0 1 66.666%;
    min-width: 240px;
  }

  input {
    box-sizing: border-box;
    width: 100%;
    height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  input::placeholder {
    color: var(--muted);
  }

  input:focus {
    border-color: var(--accent);
    outline: 3px solid var(--focus-ring);
  }

  .view-toggle {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  .view-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
  }

  .view-toggle-button:hover,
  .view-toggle-button:focus-visible {
    color: var(--accent-hover);
  }

  .view-toggle-button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .view-toggle-button.is-active {
    color: var(--text);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--border) 65%, transparent);
  }

  .view-toggle-button svg {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .search-view-controls {
      align-items: stretch;
      flex-direction: column;
    }

    .search-field {
      flex-basis: auto;
      min-width: 0;
    }

    .view-toggle {
      align-self: flex-start;
    }
  }
</style>
