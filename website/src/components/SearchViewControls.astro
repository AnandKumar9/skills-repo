---
interface Props {
  resultLabelPlural?: string;
  resultLabelSingular?: string;
  searchPlaceholder?: string;
  showSearch?: boolean;
  showViewToggle?: boolean;
  tags?: string[];
}

const {
  resultLabelPlural = "items",
  resultLabelSingular = "item",
  searchPlaceholder = "Search",
  showSearch = true,
  showViewToggle = true,
  tags = [],
} = Astro.props;
---

<div
  class="search-view-stack"
  data-search-view-controls
  data-result-label-singular={resultLabelSingular}
  data-result-label-plural={resultLabelPlural}
  aria-label="Search and view controls"
>
  {
    (showSearch || showViewToggle) && (
      <div class="search-view-controls">
        {showSearch && (
          <label class="search-field">
            <span class="sr-only">Search</span>
            <input type="search" placeholder={searchPlaceholder} data-search-input />
          </label>
        )}

        {showViewToggle && (
          <div class="view-toggle" aria-label="View mode">
            <button
              class="view-toggle-button is-active"
              type="button"
              data-view-mode-button="grid"
              aria-pressed="true"
              aria-label="Grid view"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"
                />
              </svg>
            </button>
            <button
              class="view-toggle-button"
              type="button"
              data-view-mode-button="list"
              aria-pressed="false"
              aria-label="List view"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"
                />
              </svg>
            </button>
          </div>
        )}
      </div>
    )
  }

  {
    tags.length > 0 && (
      <ul class="tag-pill-list" aria-label="Available tags">
        {tags.map((tag) => (
          <li>
            <button type="button" data-tag-filter={tag} aria-pressed="false">
              {tag}
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  const viewModeStorageKey = "skills-repo:view-mode";

  document.querySelectorAll<HTMLElement>("[data-search-view-controls]").forEach((controls) => {
    const page = controls.closest("main");
    const viewContainer = page?.querySelector<HTMLElement>("[data-view-container]");
    const searchInput = controls.querySelector<HTMLInputElement>("[data-search-input]");
    const searchItems = page?.querySelectorAll<HTMLElement>("[data-search-item]");
    const searchStatus = page?.querySelector<HTMLElement>("[data-search-status]");
    const emptyState = page?.querySelector<HTMLElement>("[data-search-empty]");
    const buttons = controls.querySelectorAll<HTMLButtonElement>("[data-view-mode-button]");
    const tagButtons = controls.querySelectorAll<HTMLButtonElement>("[data-tag-filter]");
    const activeTags = new Set<string>();

    function isViewMode(mode: string): mode is "grid" | "list" {
      return mode === "grid" || mode === "list";
    }

    function getStoredViewMode() {
      try {
        const storedMode = window.localStorage.getItem(viewModeStorageKey);
        return storedMode && isViewMode(storedMode) ? storedMode : null;
      } catch {
        return null;
      }
    }

    function storeViewMode(mode: string) {
      try {
        window.localStorage.setItem(viewModeStorageKey, mode);
      } catch {
        // Ignore storage failures so the toggle still works in private or restricted contexts.
      }
    }

    function getSearchText(item: HTMLElement) {
      return `${item.dataset.searchName ?? ""} ${item.dataset.searchDescription ?? ""} ${
        item.dataset.searchTags ?? ""
      }`.toLowerCase();
    }

    function formatResultCount(count: number) {
      const singular = controls.dataset.resultLabelSingular ?? "item";
      const plural = controls.dataset.resultLabelPlural ?? "items";
      return `${count} ${count === 1 ? singular : plural}`;
    }

    function getItemTags(item: HTMLElement) {
      return (item.dataset.searchTags ?? "")
        .toLowerCase()
        .split("|")
        .map((tag) => tag.trim())
        .filter(Boolean);
    }

    function formatSearchStatus(count: number, query: string) {
      const tagList = Array.from(activeTags);
      const rawQuery = searchInput?.value.trim() ?? "";

      if (query.length === 0 && tagList.length === 0) {
        return `${formatResultCount(count)} shown`;
      }

      if (query.length > 0 && tagList.length > 0) {
        return `${formatResultCount(count)} found for "${rawQuery}" in ${tagList.join(", ")}`;
      }

      if (query.length > 0) {
        return `${formatResultCount(count)} found for "${rawQuery}"`;
      }

      return `${formatResultCount(count)} found in ${tagList.join(", ")}`;
    }

    function updateSearchResults() {
      if (!searchItems) return;

      const query = searchInput?.value.trim().toLowerCase() ?? "";
      const currentView = viewContainer?.dataset.viewMode ?? "grid";
      let visibleCount = 0;

      searchItems.forEach((item) => {
        const itemTags = getItemTags(item);
        const matchesQuery = query.length === 0 || getSearchText(item).includes(query);
        const matchesTags =
          activeTags.size === 0 || Array.from(activeTags).some((tag) => itemTags.includes(tag.toLowerCase()));
        const isVisible = matchesQuery && matchesTags;
        item.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (searchStatus) {
        searchStatus.textContent = formatSearchStatus(visibleCount, query);
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    function setViewMode(mode: string, shouldStore = true) {
      if (!viewContainer || buttons.length === 0) return;

      viewContainer.dataset.viewMode = mode;

      buttons.forEach((button) => {
        const isActive = button.dataset.viewModeButton === mode;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });

      if (shouldStore) {
        storeViewMode(mode);
      }

      updateSearchResults();
    }

    if (viewContainer && buttons.length > 0) {
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          setViewMode(button.dataset.viewModeButton ?? "grid");
        });
      });

      setViewMode(getStoredViewMode() ?? viewContainer.dataset.viewMode ?? "grid", false);
    }

    tagButtons?.forEach((button) => {
      button.addEventListener("click", () => {
        const tag = button.dataset.tagFilter;
        if (!tag) return;

        const activeTag = Array.from(activeTags).find((selectedTag) => selectedTag.toLowerCase() === tag.toLowerCase());

        if (activeTag) {
          activeTags.delete(activeTag);
        } else {
          activeTags.add(tag);
        }

        const isActive = !activeTag;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
        updateSearchResults();
      });
    });

    searchInput?.addEventListener("input", updateSearchResults);
    updateSearchResults();
  });
</script>

<style>
  .search-view-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: -8px 0 32px;
  }

  .search-view-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
  }

  .search-field {
    flex: 0 1 66.666%;
    min-width: 240px;
  }

  input {
    box-sizing: border-box;
    width: 100%;
    height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  input::placeholder {
    color: var(--muted);
  }

  input:focus {
    border-color: var(--accent);
    outline: 3px solid var(--focus-ring);
  }

  .view-toggle {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  .view-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
  }

  .view-toggle-button:hover,
  .view-toggle-button:focus-visible {
    color: var(--accent-hover);
  }

  .view-toggle-button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .view-toggle-button.is-active {
    color: var(--text);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--border) 65%, transparent);
  }

  .view-toggle-button svg {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .tag-pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-pill-list button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface);
    font-size: 0.8125rem;
    line-height: 1.2;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  .tag-pill-list button:hover,
  .tag-pill-list button:focus-visible {
    border-color: var(--border-hover);
    color: var(--accent-hover);
  }

  .tag-pill-list button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .tag-pill-list button.is-active {
    border-color: var(--accent);
    color: var(--surface);
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), var(--card-shadow);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .search-view-controls {
      align-items: stretch;
      flex-direction: column;
    }

    .search-field {
      flex-basis: auto;
      min-width: 0;
    }

    .view-toggle {
      align-self: flex-start;
    }
  }
</style>
