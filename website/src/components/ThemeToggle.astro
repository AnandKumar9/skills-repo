<div class="theme-control">
  <a class="icon-button" href="https://github.com/" target="_blank" rel="noreferrer" aria-label="Open GitHub">
    <span class="github-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path
          d="M12 2.25c-5.38 0-9.75 4.37-9.75 9.75 0 4.3 2.79 7.95 6.66 9.24.49.09.67-.21.67-.47v-1.7c-2.71.59-3.28-1.16-3.28-1.16-.44-1.13-1.08-1.43-1.08-1.43-.89-.61.07-.6.07-.6.98.07 1.5 1.01 1.5 1.01.87 1.49 2.28 1.06 2.84.81.09-.63.34-1.06.62-1.31-2.17-.25-4.45-1.08-4.45-4.82 0-1.07.38-1.94 1.01-2.62-.1-.25-.44-1.25.1-2.59 0 0 .82-.26 2.68 1 .78-.22 1.61-.33 2.44-.33s1.66.11 2.44.33c1.86-1.26 2.68-1 2.68-1 .54 1.34.2 2.34.1 2.59.63.68 1.01 1.55 1.01 2.62 0 3.75-2.28 4.57-4.46 4.82.35.3.67.9.67 1.82v2.7c0 .26.18.57.68.47A9.75 9.75 0 0 0 21.75 12c0-5.38-4.37-9.75-9.75-9.75Z"
        />
      </svg>
    </span>
  </a>

  <button type="button" data-theme-toggle data-mode="system" aria-label="Theme: System">
    <span class="icon icon-system" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M12 3v2.25" />
        <path d="M12 18.75V21" />
        <path d="M3 12h2.25" />
        <path d="M18.75 12H21" />
        <path d="m5.64 5.64 1.59 1.59" />
        <path d="m16.77 16.77 1.59 1.59" />
        <path d="m18.36 5.64-1.59 1.59" />
        <path d="m7.23 16.77-1.59 1.59" />
        <circle cx="12" cy="12" r="4" />
      </svg>
    </span>
    <span class="icon icon-light" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2.5v2" />
        <path d="M12 19.5v2" />
        <path d="M4.25 4.25 5.7 5.7" />
        <path d="m18.3 18.3 1.45 1.45" />
        <path d="M2.5 12h2" />
        <path d="M19.5 12h2" />
        <path d="m4.25 19.75 1.45-1.45" />
        <path d="m18.3 5.7 1.45-1.45" />
      </svg>
    </span>
    <span class="icon icon-dark" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M20.5 14.4A7.8 7.8 0 0 1 9.6 3.5 8.7 8.7 0 1 0 20.5 14.4Z" />
      </svg>
    </span>
    <span class="mode-label">System</span>
  </button>
</div>

<script is:inline>
  (() => {
    const storageKey = "theme-preference";
    const labels = {
      system: "System",
      light: "Light",
      dark: "Dark",
    };
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    const getResolvedSystemMode = () => (media.matches ? "dark" : "light");
    const getOppositeMode = (mode) => (mode === "dark" ? "light" : "dark");

    const getMode = () => {
      try {
        const stored = localStorage.getItem(storageKey);
        return stored === "light" || stored === "dark" ? stored : "system";
      } catch {
        return "system";
      }
    };

    const applyMode = (mode) => {
      if (mode === "system") {
        document.documentElement.removeAttribute("data-theme");
      } else {
        document.documentElement.dataset.theme = mode;
      }
    };

    const updateButtons = (mode) => {
      const resolvedSystemMode = getResolvedSystemMode();
      const visibleLabel =
        mode === "system"
          ? `System (${labels[resolvedSystemMode]})`
          : labels[mode];

      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        const label = button.querySelector(".mode-label");
        if (label) label.textContent = visibleLabel;
        button.setAttribute("aria-label", `Theme: ${visibleLabel}`);
        button.setAttribute("title", `Theme: ${visibleLabel}`);
        button.dataset.mode = mode;
      });
    };

    const setMode = (mode) => {
      try {
        if (mode === "system") {
          localStorage.removeItem(storageKey);
        } else {
          localStorage.setItem(storageKey, mode);
        }
      } catch {
        // Ignore storage failures and keep the in-page theme change.
      }

      applyMode(mode);
      updateButtons(mode);
    };

    const boot = () => {
      const mode = getMode();
      applyMode(mode);
      updateButtons(mode);

      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const currentMode = getMode();
          const nextMode =
            currentMode === "system"
              ? getOppositeMode(getResolvedSystemMode())
              : "system";
          setMode(nextMode);
        });
      });
    };

    applyMode(getMode());

    media.addEventListener("change", () => {
      const mode = getMode();
      if (mode === "system") {
        updateButtons(mode);
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
      boot();
    }
  })();
</script>

<style>
  .theme-control {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin-bottom: 28px;
  }

  .icon-button,
  button {
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    justify-content: center;
    line-height: 1;
    min-height: 2.5rem;
    min-width: 2.5rem;
    overflow: hidden;
    padding: 0;
    width: 2.5rem;
  }

  .icon-button {
    text-decoration: none;
  }

  .icon-button:hover,
  button:hover {
    border-color: var(--border-hover);
    color: var(--accent-hover);
    box-shadow: var(--card-shadow);
  }

  .icon-button:focus-visible,
  button:focus-visible {
    border-color: var(--accent);
    outline: 3px solid var(--focus-ring);
  }

  .github-icon,
  .icon {
    display: none;
    height: 1.15rem;
    flex: 0 0 auto;
    width: 1.15rem;
  }

  .github-icon {
    display: block;
  }

  button[data-mode="system"] .icon-system,
  button[data-mode="light"] .icon-light,
  button[data-mode="dark"] .icon-dark {
    display: block;
  }

  svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .github-icon > svg {
    fill: currentColor;
    height: 100%;
    width: 100%;
  }

  .icon > svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  svg * {
    fill: none;
    stroke: currentColor;
  }

  .github-icon > svg * {
    fill: currentColor;
    stroke: none;
  }

  .mode-label {
    clip: rect(0 0 0 0);
    border: 0;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>
