<dialog class="skill-dialog" aria-labelledby="skill-dialog-title">
  <div class="dialog-panel">
    <div class="dialog-content">
      <button class="dialog-close" type="button" data-skill-dialog-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m6 6 12 12M18 6 6 18"
          />
        </svg>
      </button>
      <h2 id="skill-dialog-title"></h2>
      <p id="skill-dialog-author" class="dialog-author" hidden></p>
      <p id="skill-dialog-description"></p>
    </div>
    <footer class="card-footer dialog-footer">
      <div class="footer-tags">
        <ul class="tag-list" data-dialog-tags aria-label="Tags"></ul>
      </div>
      <div class="footer-actions">
        <a
          class="footer-icon-link"
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.15c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18A10.92 10.92 0 0 1 12 6.05c.98 0 1.95.13 2.87.38 2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.82 1.19 3.08 0 4.42-2.69 5.39-5.25 5.68.42.36.78 1.07.78 2.16v3.14c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            />
          </svg>
        </a>
      </div>
    </footer>
  </div>
</dialog>

<dialog class="install-dialog" aria-labelledby="install-dialog-title">
  <div class="install-panel">
    <button class="dialog-close" type="button" data-install-dialog-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m6 6 12 12M18 6 6 18"
        />
      </svg>
    </button>
    <h2 id="install-dialog-title">Install</h2>
    <div class="install-command-row">
      <code data-install-command></code>
      <button class="copy-command" type="button" data-copy-install-command aria-label="Copy install command">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 8V5.2C8 4.08 8 3.52 8.22 3.09a2 2 0 0 1 .87-.87C9.52 2 10.08 2 11.2 2h7.6c1.12 0 1.68 0 2.11.22a2 2 0 0 1 .87.87c.22.43.22.99.22 2.11v7.6c0 1.12 0 1.68-.22 2.11a2 2 0 0 1-.87.87c-.43.22-.99.22-2.11.22H16M5.2 22h7.6c1.12 0 1.68 0 2.11-.22a2 2 0 0 0 .87-.87c.22-.43.22-.99.22-2.11v-7.6c0-1.12 0-1.68-.22-2.11a2 2 0 0 0-.87-.87C14.48 8 13.92 8 12.8 8H5.2c-1.12 0-1.68 0-2.11.22a2 2 0 0 0-.87.87C2 9.52 2 10.08 2 11.2v7.6c0 1.12 0 1.68.22 2.11a2 2 0 0 0 .87.87c.43.22.99.22 2.11.22Z"
          />
        </svg>
      </button>
    </div>
    <p class="copy-status" data-copy-status aria-live="polite"></p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".skill-dialog");
  const installDialog = document.querySelector<HTMLDialogElement>(".install-dialog");
  const dialogTitle = document.querySelector<HTMLElement>("#skill-dialog-title");
  const dialogAuthor = document.querySelector<HTMLElement>("#skill-dialog-author");
  const dialogDescription = document.querySelector<HTMLElement>("#skill-dialog-description");
  const dialogTags = document.querySelector<HTMLElement>("[data-dialog-tags]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-skill-dialog-close]");
  const installCloseButton = document.querySelector<HTMLButtonElement>("[data-install-dialog-close]");
  const installDialogTitle = document.querySelector<HTMLElement>("#install-dialog-title");
  const installCommand = document.querySelector<HTMLElement>("[data-install-command]");
  const copyInstallCommand = document.querySelector<HTMLButtonElement>("[data-copy-install-command]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

  function openSkillDialog(card: HTMLElement) {
    if (!dialog || !dialogTitle || !dialogDescription) return;

    const skillName = card.dataset.skillName ?? "";
    const skillTitle = card.dataset.skillTitle ?? skillName;
    const author = card.dataset.skillAuthor ?? "";
    const tags = (card.dataset.skillTags ?? "")
      .split(",")
      .map((tag) => tag.trim())
      .filter(Boolean);
    dialogTitle.textContent = skillTitle;
    if (dialogAuthor) {
      dialogAuthor.textContent = author;
      dialogAuthor.hidden = author.length === 0;
    }
    dialogDescription.textContent = card.dataset.skillDescription || "No description provided.";
    if (dialogTags) {
      dialogTags.replaceChildren(
        ...tags.map((tag) => {
          const item = document.createElement("li");
          item.textContent = tag;
          return item;
        }),
      );
      dialogTags.hidden = tags.length === 0;
    }
    dialog.showModal();
  }

  function openInstallDialog(card: HTMLElement) {
    if (!installDialog || !installCommand) return;

    const skillName = card.dataset.skillName ?? "";
    const command = card.dataset.downloadCommand || `npx skills add ${skillName}`;
    if (installDialogTitle) {
      installDialogTitle.textContent = card.dataset.downloadDialogTitle || "Install";
    }
    installCommand.textContent = command;
    if (copyStatus) copyStatus.textContent = "";
    installDialog.showModal();
  }

  async function copyCommandToClipboard() {
    const command = installCommand?.textContent ?? "";
    if (!command) return;

    try {
      await navigator.clipboard.writeText(command);
      if (copyStatus) copyStatus.textContent = "Copied";
    } catch {
      const selection = window.getSelection();
      const range = document.createRange();
      if (!installCommand) return;
      range.selectNodeContents(installCommand);
      selection?.removeAllRanges();
      selection?.addRange(range);
      if (copyStatus) copyStatus.textContent = "Select and copy";
    }
  }

  document.querySelectorAll<HTMLElement>("[data-skill-card]").forEach((card) => {
    card.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest(".footer-icon-link")) return;
      openSkillDialog(card);
    });

    card.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      if ((event.target as HTMLElement).closest(".footer-icon-link")) return;

      event.preventDefault();
      openSkillDialog(card);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-skill-download]").forEach((downloadLink) => {
    downloadLink.addEventListener("click", (event) => {
      event.preventDefault();
      const card = downloadLink.closest<HTMLElement>("[data-skill-card]");
      if (card) openInstallDialog(card);
    });
  });

  closeButton?.addEventListener("click", () => dialog?.close());
  installCloseButton?.addEventListener("click", () => installDialog?.close());
  copyInstallCommand?.addEventListener("click", () => {
    void copyCommandToClipboard();
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });

  installDialog?.addEventListener("click", (event) => {
    if (event.target === installDialog) {
      installDialog.close();
    }
  });
</script>

<style>
  .skill-dialog,
  .install-dialog {
    width: min(420px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
    border-radius: 8px;
    color: var(--text);
    background: var(--surface);
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.18);
  }

  .skill-dialog {
    min-height: min(300px, calc(100vh - 48px));
  }

  .install-dialog {
    max-width: calc(100vw - 32px);
  }

  .skill-dialog::backdrop,
  .install-dialog::backdrop {
    background: rgba(15, 23, 42, 0.48);
  }

  .dialog-panel {
    min-height: inherit;
    box-sizing: border-box;
    display: grid;
    grid-template-rows: minmax(0, 1fr) 44px;
  }

  .dialog-content {
    position: relative;
    min-height: 0;
    padding: 1.75rem;
    overflow: auto;
  }

  .install-panel {
    position: relative;
    box-sizing: border-box;
    padding: 1.75rem;
  }

  .card-footer {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    height: 36px;
    padding: 0 1rem;
    background: var(--surface);
  }

  .dialog-footer {
    height: 44px;
    border-top: 1px solid color-mix(in srgb, var(--border) 45%, transparent);
  }

  .footer-tags {
    min-width: 0;
    overflow: hidden;
  }

  .footer-actions {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 0.625rem;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
    text-decoration: none;
  }

  .footer-icon-link svg {
    display: block;
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }

  .tag-list :global(li) {
    flex: 0 0 auto;
    padding: 0.1875rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    background: var(--bg);
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .dialog-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    background: var(--bg);
    box-shadow: var(--card-shadow);
    cursor: pointer;
  }

  .dialog-close:hover,
  .dialog-close:focus-visible {
    color: var(--accent-hover);
    border-color: var(--border-hover);
    background: var(--surface);
  }

  .dialog-close:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .dialog-close svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  .skill-dialog h2,
  .install-dialog h2 {
    margin: 0;
    padding-right: 2.75rem;
    color: var(--text);
    font-size: 1.35rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .install-command-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
  }

  .install-command-row code {
    min-width: 0;
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .copy-command {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    background: var(--surface);
    cursor: pointer;
  }

  .copy-command:hover,
  .copy-command:focus-visible {
    color: var(--accent-hover);
    border-color: var(--border-hover);
  }

  .copy-command:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .copy-command svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  .copy-status {
    min-height: 1.25rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .dialog-author {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .skill-dialog p:not(.dialog-author) {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
    white-space: pre-line;
  }
</style>
