---
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navSections = [
  {
    items: [{ label: "Home", href: "/" }],
  },
  {
    items: [
      { label: "Skills", href: "/skills/" },
      { label: "Subagents", href: "/subagents/" },
      { label: "Tags", href: "/tags/" },
    ],
  },
  {
    items: [
      { label: "AI Field Guide", href: "/ai-field-guide/", target: "_blank", rel: "noopener noreferrer" },
      { label: "Useful Resources", href: "/useful-resources/" },
    ],
  },
  {
    items: [{ label: "Contribute", href: "/contribute/" }],
  },
];

const currentPath = Astro.url.pathname;

function withBase(href: string) {
  if (href === "/") {
    return baseUrl;
  }

  return `${baseUrl}${href.replace(/^\/+/, "")}`;
}

function isActive(href: string) {
  const basedHref = withBase(href);

  if (basedHref === baseUrl) {
    return currentPath === basedHref;
  }

  return currentPath === basedHref || currentPath.startsWith(basedHref);
}
---

<aside class="sidebar" aria-label="Primary navigation">
  <nav class="sidebar-stack">
    <a class="sidebar-logo-card" href={withBase("/")} aria-label="Go to home page">
      <svg class="site-icon" viewBox="0 0 64 64" role="img" aria-label="Site icon">
        <rect width="64" height="64" rx="14" fill="#1f6feb" />
        <path
          d="M20 18h16a8 8 0 0 1 0 16H20V18Zm8 8v0h8a0 0 0 0 0 0 0h-8Zm-8 12h20a8 8 0 0 1 0 16H20V38Zm8 8v0h12a0 0 0 0 0 0 0H28Z"
          fill="#fff"
        />
        <circle cx="46" cy="18" r="6" fill="#facc15" />
      </svg>
    </a>
    {
      navSections.map((section, index) => (
        <section class="sidebar-card" aria-label={`Navigation section ${index + 1}`}>
          <ul>
            {section.items.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  target={item.target}
                  rel={item.rel}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  <span>{item.label}</span>
                  {
                    item.target === "_blank" && (
                      <svg
                        aria-hidden="true"
                        class="external-link-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                      >
                        <path d="M15 3h6v6" />
                        <path d="M10 14 21 3" />
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      </svg>
                    )
                  }
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 24px;
    align-self: start;
    box-sizing: border-box;
    width: 220px;
    max-height: calc(100vh - 48px);
    overflow: auto;
  }

  .sidebar-stack {
    display: grid;
    gap: 1.25rem;
  }

  .sidebar-card {
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  .sidebar-logo-card {
    justify-content: center;
    padding: 1rem;
    border: 1px solid var(--border);
    background: var(--heading-bg);
    box-shadow: var(--card-shadow);
  }

  .site-icon {
    width: 3rem;
    height: 3rem;
  }

  ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .external-link-icon {
    flex: 0 0 auto;
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0.72;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent-hover);
    background: var(--bg);
  }

  a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  a[aria-current="page"] {
    color: var(--text);
    background: var(--heading-bg);
  }

  .sidebar-logo-card:hover,
  .sidebar-logo-card:focus-visible {
    background: var(--surface);
  }

  @media (max-width: 800px) {
    .sidebar {
      position: static;
      width: 100%;
      max-height: none;
      overflow: visible;
    }

    .sidebar-stack {
      gap: 1rem;
    }

    ul {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }

    a {
      padding: 0.625rem 0.5rem;
      text-align: center;
    }
  }

  @media (max-width: 560px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    a {
      text-align: left;
    }
  }
</style>
