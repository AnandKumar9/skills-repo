---
import fs from "node:fs";
import path from "node:path";

const skillsDir = path.resolve("../skills");

const skills = fs
  .readdirSync(skillsDir, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name)
  .sort();
---
<meta charset="utf-8" />

<main class="page">
  <a class="back" href="/">&larr; Home</a>

  <section class="hero">
    <h1>Skills</h1>
    <p>Browse all skill folders from the repo.</p>
  </section>

  <section class="grid">
    {skills.map((skill) => (
      <a class="card" href="#">
        <span class="icon">&#129504;</span>
        <span>{skill}</span>
      </a>
    ))}
  </section>
</main>

<style>
  :global(:root) {
    color-scheme: light;
    --bg: #f8fafc;
    --surface: #ffffff;
    --text: #1f2933;
    --muted: #667085;
    --border: #d9e0e8;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
  }

  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 64px 24px;
  }

  .back {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .hero {
    margin: 32px 0 36px;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: 0;
  }

  p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    background: var(--surface);
    box-shadow: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
  }

  .card:hover {
    border-color: #b8c2cc;
    color: var(--accent-hover);
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06);
  }

  .icon {
    display: block;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
</style>
