---
---

<main class="home">
  <h1>DCI Skills Repository</h1>

  <input placeholder="Search" />

  <div class="cards">
    <a href="/skills/">Skills</a>
    <a href="/subagents/">Subagents</a>
  </div>
</main>

<style>
  :global(:root) {
    color-scheme: light;
    --bg: #f8fafc;
    --surface: #ffffff;
    --text: #1f2933;
    --muted: #667085;
    --border: #d9e0e8;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
  }

  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .home {
    max-width: 960px;
    margin: 0 auto;
    padding: 64px 24px;
    text-align: left;
  }

  h1 {
    margin: 0 0 12px;
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 650;
    letter-spacing: 0;
  }

  input {
    width: min(100%, 520px);
    box-sizing: border-box;
    padding: 0.75rem 0.875rem;
    margin: 28px 0 32px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  input::placeholder {
    color: var(--muted);
  }

  input:focus {
    border-color: var(--accent);
    outline: 3px solid rgba(37, 99, 235, 0.14);
  }

  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cards a {
    min-width: 180px;
    border: 1px solid var(--border);
    padding: 1rem 1.125rem;
    text-decoration: none;
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }

  .cards a:hover {
    border-color: #b8c2cc;
    color: var(--accent-hover);
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06);
  }
</style>
