---
import PageHeading from "../components/PageHeading.astro";
import SearchViewControls from "../components/SearchViewControls.astro";
import "../styles/theme.css";
---

<main class="home">
  <PageHeading isHome />

  <SearchViewControls showViewToggle={false} />

  <div class="cards">
    <a href="/skills/">Skills</a>
    <a href="/subagents/">Subagents</a>
  </div>
</main>

<style>
  .home {
    max-width: 960px;
    margin: 0 auto;
    padding: 64px 24px;
    text-align: left;
  }

  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cards a {
    min-width: 180px;
    border: 1px solid var(--border);
    padding: 1rem 1.125rem;
    text-decoration: none;
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }

  .cards a:hover {
    border-color: var(--border-hover);
    color: var(--accent-hover);
    box-shadow: var(--card-shadow);
  }
</style>
