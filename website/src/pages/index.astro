---
import PageHeading from "../components/PageHeading.astro";
import SearchViewControls from "../components/SearchViewControls.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout>
  <main class="home">
    <PageHeading isHome />

    <SearchViewControls showViewToggle={false} />

    <div class="cards">
      <a href="/skills/">Skills</a>
      <a href="/subagents/">Subagents</a>
    </div>
  </main>
</SiteLayout>

<style>
  .home {
    max-width: 960px;
    margin: 0 auto;
    text-align: left;
  }

  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cards a {
    min-width: 180px;
    border: 1px solid var(--border);
    padding: 1rem 1.125rem;
    text-decoration: none;
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }

  .cards a:hover {
    border-color: var(--border-hover);
    color: var(--accent-hover);
    box-shadow: var(--card-shadow);
  }
</style>
