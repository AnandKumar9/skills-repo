---
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/theme.css";
---

<main class="home">
  <div class="page-heading">
    <h1>DCI Skills Repository</h1>
    <ThemeToggle />
  </div>

  <input placeholder="Search" />

  <div class="cards">
    <a href="/skills/">Skills</a>
    <a href="/subagents/">Subagents</a>
  </div>
</main>

<style>
  .home {
    max-width: 960px;
    margin: 0 auto;
    padding: 64px 24px;
    text-align: left;
  }

  .page-heading {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .page-heading :global(.theme-control) {
    flex: 0 0 auto;
    margin-bottom: 0;
  }

  h1 {
    flex: 1 1 auto;
    margin: 0;
    min-width: 0;
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 650;
    letter-spacing: 0;
  }

  input {
    width: min(100%, 520px);
    box-sizing: border-box;
    padding: 0.75rem 0.875rem;
    margin: 28px 0 32px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  input::placeholder {
    color: var(--muted);
  }

  input:focus {
    border-color: var(--accent);
    outline: 3px solid var(--focus-ring);
  }

  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cards a {
    min-width: 180px;
    border: 1px solid var(--border);
    padding: 1rem 1.125rem;
    text-decoration: none;
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
  }

  .cards a:hover {
    border-color: var(--border-hover);
    color: var(--accent-hover);
    box-shadow: var(--card-shadow);
  }
</style>
