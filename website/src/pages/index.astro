---
import PageHeading from "../components/PageHeading.astro";
import SearchViewControls from "../components/SearchViewControls.astro";
import ContentCard from "../components/ContentCard.astro";
import SkillDialog from "../components/SkillDialog.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  getContentUpdates,
  getDeclaredTags,
  getRules,
  getSkills,
  getSubagents,
  sortByRecentUpdate,
} from "../lib/repoContent.mjs";

const baseUrl = import.meta.env.BASE_URL;
const tags = getDeclaredTags();
const contentUpdates = getContentUpdates();
const skills = sortByRecentUpdate(getSkills(), "skills", contentUpdates);
const subagents = sortByRecentUpdate(getSubagents(), "subagents", contentUpdates);
const rules = sortByRecentUpdate(getRules(), "rules", contentUpdates);
---

<SiteLayout>
  <main class="home">
    <PageHeading isHome />

    <SearchViewControls showViewToggle={false} tags={tags} />

    <section class="skills-section" data-search-section aria-labelledby="home-skills-title">
      <div class="section-header">
        <h2 id="home-skills-title">Latest Skills</h2>
        <a class="view-all" href={`${baseUrl}skills/`}>View All</a>
      </div>

      <div class="grid" data-view-mode="grid">
        {skills.map((skill, index) => <ContentCard item={skill} defaultHidden={index >= 6} dialogEnabled />)}
      </div>
    </section>

    <section class="content-section" data-search-section aria-labelledby="home-subagents-title">
      <div class="section-header">
        <h2 id="home-subagents-title">Latest Subagents</h2>
        <a class="view-all" href={`${baseUrl}subagents/`}>View All</a>
      </div>

      <div class="grid" data-view-mode="grid">
        {subagents.map((subagent, index) => <ContentCard item={subagent} defaultHidden={index >= 6} dialogEnabled />)}
      </div>
    </section>

    <section class="content-section" data-search-section aria-labelledby="home-rules-title">
      <div class="section-header">
        <h2 id="home-rules-title">Latest Rules</h2>
        <a class="view-all" href={`${baseUrl}rules/`}>View All</a>
      </div>

      <div class="grid" data-view-mode="grid">
        {rules.map((rule, index) => (
          <ContentCard item={rule} defaultHidden={index >= 6} dialogEnabled variant="compact" />
        ))}
      </div>
    </section>

    <SkillDialog />
  </main>
</SiteLayout>

<style>
  .home {
    max-width: 1000px;
    margin: 0 auto;
    text-align: left;
  }

  .skills-section,
  .content-section {
    margin-bottom: 1.5rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-header h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    background: var(--surface);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .view-all:hover,
  .view-all:focus-visible {
    border-color: var(--border-hover);
    color: var(--accent-hover);
    box-shadow: var(--card-shadow);
  }

  .view-all:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 315px);
    justify-content: space-between;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      justify-content: stretch;
    }
  }
</style>
