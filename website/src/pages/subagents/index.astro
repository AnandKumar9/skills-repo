---
import fs from "node:fs";
import path from "node:path";
import ThemeToggle from "../../components/ThemeToggle.astro";
import "../../styles/theme.css";

const subagentsDir = path.resolve("../subagents");

const items = fs
  .readdirSync(subagentsDir, { withFileTypes: true })
  .filter((entry) => {
    if (entry.isDirectory()) return true;
    if (entry.isFile() && entry.name.endsWith(".md")) return true;
    return false;
  })
  .map((entry) => entry.name)
  .sort();
---

<main class="page">
  <ThemeToggle />

  <h1>Subagents</h1>

  <ul class="list">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</main>

<style>
  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 64px 24px;
  }

  h1 {
    margin: 0 0 32px;
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: 0;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
  }
</style>
