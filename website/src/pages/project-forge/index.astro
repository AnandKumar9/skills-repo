---
import PageHeading from "../../components/PageHeading.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout>
  <main class="page">
    <PageHeading
      pageTitle="Project Forge"
      pageDescription="A central index for AI skills, agents, hooks, context files, and related tooling used within DCI."
    />

    <section class="panel">
      <h2>Repository Content</h2>
      <p>
        This site reads content from the repository root, including folders such as skills and subagents, then presents
        that content through browsable static pages.
      </p>
    </section>
  </main>
</SiteLayout>

<style>
  .page {
    max-width: 960px;
    margin: 0 auto;
  }

  .panel {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    line-height: 1.25;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
